# ============================================================
# Mallor — variables de producción (VPS + Docker)
# Copia este archivo a `.env` en el servidor y rellena valores reales.
# NUNCA versiones el `.env` real.
# ============================================================

# --- Django / seguridad ---
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
FRONTEND_URL=https://tu-dominio.com

# --- Modo de ejecución ---
MALLOR_MODE=cloud
MALLOR_SERVE_FRONTEND=True
MALLOR_ENABLE_BASIC_AUTH=False

# --- Base de datos (MySQL, contenedor `db`) ---
# El compose construye DATABASE_URL automáticamente a partir de MYSQL_*.
# La contraseña debe ser URL-safe (sin : / @ #). Si no, define DATABASE_URL
# manualmente con el valor urlencoded.
MYSQL_DATABASE=mallor
MYSQL_USER=mallor
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# --- Gunicorn (entrypoint) ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Media (bind mount en el host) ---
MEDIA_ROOT=/app/media
MEDIA_HOST_PATH=/opt/mallor/media

# --- Cookies / SSL ---
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0

# --- Factus (facturación electrónica) ---
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_TIMEOUT=30
FACTUS_MAX_RETRIES=2
FACTUS_VERIFY_SSL=True
MALLOR_DATA_ENCRYPTION_KEY=cambia-por-clave-fernet-valida

# --- IA (DeepSeek) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_TEMPERATURE=0.1
IA_MAX_HISTORY_MESSAGES=12
IA_MAX_TOOL_RESULTS=20
IA_HISTORY_RESULT_MAX_CHARS=4000

# --- Turnstile (Cloudflare) ---
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=False

# --- Correo ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
