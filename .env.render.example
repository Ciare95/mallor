DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-render-generated-secret
DEBUG=False
MALLOR_MODE=cloud
MALLOR_LOCAL_SERVER=False
MALLOR_SERVE_FRONTEND=True
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-service.onrender.com
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
MALLOR_DATA_ENCRYPTION_KEY=replace-with-fernet-compatible-key
MEDIA_ROOT=/var/data/media
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_TIMEOUT=30
FACTUS_MAX_RETRIES=2
FACTUS_VERIFY_SSL=True
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
