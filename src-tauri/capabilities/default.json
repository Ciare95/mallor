{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos para la ventana principal de Mallor Local",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "mallor-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "dialog:allow-message"
  ]
}
