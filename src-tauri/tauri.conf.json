{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mallor Local",
  "version": "0.1.6",
  "identifier": "com.mallor.local",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8765",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "frontendDist": "http://localhost:8765"
  },
  "app": {
    "windows": [
      {
        "title": "Mallor Local",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mallor-server"
    ],
    "resources": {
      "binaries/_internal": "_internal"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "publisher": "Mallor",
    "copyright": "© 2025 Mallor"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNzBCQzAzMkU4Q0I0QwpSV1JNeStneXdBdW5BN0xaQlNOaGk4VDNrWHFFam91WURJWXVYRjNuRWRuV3JPSmROalhWOFFLOQo=",
      "endpoints": [
        "https://github.com/Ciare95/mallor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": false
    }
  }
}
